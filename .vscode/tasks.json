{
    "version": "2.0.0",
    "tasks": [
        {
            // Forwards the phone's 127.0.0.1:80 to this PC's web server (Laragon), so a debug build with
            // DEV_CONNECT_ADDRESS=127.0.0.1 reaches the backend without a tunnel. Lost on unplug/reboot,
            // so it runs before every USB launch. Never blocks the launch: with no phone attached it
            // only prints adb's error.
            "label": "adb reverse (USB)",
            "type": "shell",
            "command": "adb reverse tcp:80 tcp:80; exit 0",
            "presentation": {
                "reveal": "silent",
                "panel": "shared"
            },
            "problemMatcher": []
        }
    ]
}
